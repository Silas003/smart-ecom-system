<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ecom.controllers.OrderManagementController" style="-fx-background-color: #f5f5f5;">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20; -fx-background-color: white;">
                <Button text="Back" onAction="#handleBack" style="-fx-background-color: #000000; -fx-text-fill: white; -fx-font-weight: bold;
                                  -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 16px;"/>
                <Label text="Order Management" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="statusFilter" onAction="#handleStatusFilter" prefWidth="200"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="0" style="-fx-padding: 20;">
            <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-background-radius: 8;">
                <columns>
                    <TableColumn fx:id="orderIdColumn" text="Order ID" prefWidth="120"/>
                    <TableColumn fx:id="customerColumn" text="Customer" prefWidth="200"/>
                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="150"/>
                    <TableColumn fx:id="totalColumn" text="Total" prefWidth="100"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="150"/>
                </columns>

            </TableView>

            <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 15 0 0 0;">
                <Button text="View Details" onAction="#handleViewOrder" prefWidth="120"
                        style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-cursor: hand;"/>
                <Button text="Update Status" onAction="#handleUpdateStatus" prefWidth="120"
                        style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>