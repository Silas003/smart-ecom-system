<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ecom.controllers.CategoryManagementController" style="-fx-background-color: #f5f5f5;">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20; -fx-background-color: white;">
                <Button text="Back" onAction="#handleBack" style="-fx-background-color: transparent; -fx-cursor: hand;"/>
                <Label text="Category Management" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Add Category" onAction="#handleAddCategory"
                        style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;"/>
            </HBox>

            <HBox spacing="10" style="-fx-padding: 15 20; -fx-background-color: white;">
                <TextField fx:id="searchField" promptText="Search categories..." prefWidth="400" prefHeight="35"/>
                <Button text="Search" onAction="#handleSearch" prefHeight="35"
                        style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="0" style="-fx-padding: 20;">
            <TableView fx:id="categoriesTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-background-radius: 8;">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="100"/>
                    <TableColumn fx:id="nameColumn" text="Category Name" prefWidth="300"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 15 0 0 0;">
                <Button text="Edit" onAction="#handleEditCategory" prefWidth="100"
                        style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-cursor: hand;"/>
                <Button text="Delete" onAction="#handleDeleteCategory" prefWidth="100"
                        style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-cursor: hand;"/>
                <!-- Progress indicator for background operations -->
                <ProgressIndicator fx:id="progress" visible="false" prefWidth="20" prefHeight="20" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
