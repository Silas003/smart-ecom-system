<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ecom.controllers.SignUpController"
           style="-fx-background-color: #f5f5f5;">

    <VBox alignment="CENTER" spacing="20" style="-fx-padding: 40;">

        <!-- Login Form Container -->
        <VBox alignment="CENTER" spacing="15" maxWidth="400"
              style="-fx-background-color: white; -fx-background-radius: 10;
                     -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

            <!-- Title -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Smart e-com"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333;">
                    <font>
                        <Font name="System Bold" size="28.0"/>
                    </font>
                </Label>
            </HBox>

            <Label text="Signup account"
                   style="-fx-text-fill: #666; -fx-font-size: 14px;"/>

             <!-- Email Field -->
            <VBox spacing="5">
                <Label text="Username"
                       style="-fx-text-fill: #333; -fx-font-weight: bold;"/>
                <TextField fx:id="usernameField"
                           promptText="Enter your useername"
                           prefHeight="40"
                           style="-fx-background-radius: 5; -fx-border-color: #ddd;
                                 -fx-border-radius: 5; -fx-padding: 10;"/>
            </VBox>
             <!-- Email Field -->
            <VBox spacing="5">
                <Label text="phone number"
                       style="-fx-text-fill: #333; -fx-font-weight: bold;"/>
                <TextField fx:id="phoneField"
                           promptText="Enter your phone number"
                           prefHeight="40"
                           style="-fx-background-radius: 5; -fx-border-color: #ddd;
                                 -fx-border-radius: 5; -fx-padding: 10;"/>
            </VBox>
            <!-- Email Field -->
            <VBox spacing="5">
                <Label text="Email"
                       style="-fx-text-fill: #333; -fx-font-weight: bold;"/>
                <TextField fx:id="emailField"
                           promptText="Enter your email"
                           prefHeight="40"
                           style="-fx-background-radius: 5; -fx-border-color: #ddd;
                                 -fx-border-radius: 5; -fx-padding: 10;"/>
            </VBox>

            <!-- Password Field -->
            <VBox spacing="5">
                <Label text="Password"
                       style="-fx-text-fill: #333; -fx-font-weight: bold;"/>
                <PasswordField fx:id="passwordField"
                               promptText="Enter your password"
                               prefHeight="40"
                               style="-fx-background-radius: 5; -fx-border-color: #ddd;
                                     -fx-border-radius: 5; -fx-padding: 10;"/>
            </VBox>


            <!-- Signup Button -->
            <Button fx:id="SignUpButton"
                    text="SignUp"
                    onAction="#handleSignup"
                    prefWidth="340"
                    prefHeight="45"
                    style="-fx-background-color: #007bff; -fx-text-fill: white;
                           -fx-font-size: 16px; -fx-font-weight: bold;
                           -fx-background-radius: 5; -fx-cursor: hand;">
                <font>
                    <Font name="System Bold" size="16.0"/>
                </font>
            </Button>

            <!-- Login Link -->
            <HBox alignment="CENTER" spacing="5">
                <Label text="Already have an account?"
                       style="-fx-text-fill: #666;"/>
                <Hyperlink fx:id="loginlink"
                           text="Login"
                           onAction="#handleLogin"
                           style="-fx-text-fill: #007bff;"/>
            </HBox>

        </VBox>
    </VBox>
</StackPane>
