<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ecom.controllers.AdminDashboardController" style="-fx-background-color: #f5f5f5;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18" style="-fx-padding: 18; -fx-background-color: #343a40;">
            <Button text="Back" onAction="#handleBack" style="-fx-background-color: #000000; -fx-text-fill: white; -fx-font-weight: bold;
                                  -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 14px;"/>
            <Label text="Admin Dashboard" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Manage Products" onAction="#handleManageProducts"
                    style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-cursor: hand;"/>
            <Button text="Manage Categories" onAction="#handleManageCategories"
                    style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-cursor: hand;"/>
            <Button text="Manage Orders" onAction="#handleManageOrders"
                    style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-cursor: hand;"/>
            <Button text="Manage Users" onAction="#handleManageUsers"
                    style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="20" style="-fx-padding: 20;">
                <!-- Statistics Cards -->
                <HBox spacing="20">
                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
                        <Label text="Total Sales" style="-fx-text-fill: #666;"/>
                        <Label fx:id="totalSalesLabel" text=" 0.00"
                               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #28a745;"/>
                    </VBox>

                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
                        <Label text="Total Orders" style="-fx-text-fill: #666;"/>
                        <Label fx:id="totalOrdersLabel" text="0"
                               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #007bff;"/>
                    </VBox>

                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
                        <Label text="Total Customers" style="-fx-text-fill: #666;"/>
                        <Label fx:id="totalCustomersLabel" text="0"
                               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #ffc107;"/>
                    </VBox>

                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
                        <Label text="Cache Stats" style="-fx-text-fill: #666;"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Hits:"/>
                            <Label fx:id="cacheHitsLabel" text="0"/>
                            <Label text="Misses:"/>
                            <Label fx:id="cacheMissesLabel" text="0"/>
                            <Button text="Clear Cache" onAction="#handleClearCache" style="-fx-background-color: #dc3545; -fx-text-fill: white;"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Sales Chart -->
                <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
                    <Label text="Sales Overview" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
                    <LineChart fx:id="salesChart" prefHeight="300">
                        <xAxis>
                            <CategoryAxis label="Day"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Sales ( )"/>
                        </yAxis>
                    </LineChart>
                </VBox>

                <!-- Recent Orders Table -->
                <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
                    <Label text="Recent Orders" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
                    <TableView fx:id="recentOrdersTable" prefHeight="300">
                        <columns>
                            <TableColumn text="Order ID" prefWidth="100"/>
                            <TableColumn text="Customer" prefWidth="200"/>
                            <TableColumn text="Date" prefWidth="150"/>
                            <TableColumn text="Total" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- Performance Monitoring Section -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
                    <Label text="Performance Monitoring" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
                    
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <VBox spacing="5">
                            <Label text="Average Query Time:" style="-fx-text-fill: #666;"/>
                            <Label fx:id="avgQueryTimeLabel" text="0.00 ms" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #007bff;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Performance Summary:" style="-fx-text-fill: #666;"/>
                            <Label fx:id="performanceSummaryLabel" text="No performance data available" 
                                   style="-fx-font-size: 12px; -fx-text-fill: #666; -fx-wrap-text: true;"/>
                        </VBox>
                    </HBox>
                    
                    <Separator/>
                    
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Capture Baseline" onAction="#handleCaptureBaseline" 
                                style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-cursor: hand;"/>
                        <Button text="Capture Optimized" onAction="#handleCaptureOptimized" 
                                style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-cursor: hand;"/>
                        <Button text="Generate Report" onAction="#handleGenerateReport" 
                                style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-cursor: hand;"/>
                        <Button text="Clear Metrics" onAction="#handleClearMetrics" 
                                style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-cursor: hand;"/>
                    </HBox>
                    
                    <Label text="Instructions: 1) Capture Baseline before optimization, 2) Perform operations, 3) Capture Optimized, 4) Generate Report" 
                           style="-fx-font-size: 11px; -fx-text-fill: #999; -fx-wrap-text: true;"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>