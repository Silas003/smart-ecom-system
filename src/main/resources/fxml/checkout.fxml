<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ecom.controllers.CheckoutController" style="-fx-background-color: #f5f5f5;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20; -fx-background-color: white;">
            <Label text="Checkout" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <HBox spacing="20" style="-fx-padding: 20;">
                <!-- Checkout Form -->
                <VBox spacing="20" HBox.hgrow="ALWAYS" prefWidth="600">
                    <!-- Shipping Information -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
                        <Label text="Shipping Information" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                        <VBox spacing="5">
                            <Label text="Full Name *" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="fullNameField" promptText="Enter full name" prefHeight="35"/>
                        </VBox>

                        <HBox spacing="10">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Email *" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="emailField" promptText="Enter email" prefHeight="35"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Phone *" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="phoneField" promptText="Enter phone" prefHeight="35"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="5">
                            <Label text="Address *" style="-fx-font-weight: bold;"/>
                            <TextArea fx:id="addressField" promptText="Enter shipping address" prefRowCount="3"/>
                        </VBox>

                        <HBox spacing="10">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="City *" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="cityField" promptText="City" prefHeight="35"/>
                            </VBox>
                            <VBox spacing="5" prefWidth="150">
                                <Label text="State *" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="stateField" promptText="State" prefHeight="35"/>
                            </VBox>
                            <VBox spacing="5" prefWidth="150">
                                <Label text="ZIP Code *" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="zipField" promptText="ZIP" prefHeight="35"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Payment Information -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
                        <Label text="Payment Information" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                        <VBox spacing="5">
                            <Label text="Payment Method *" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="paymentMethodCombo" prefHeight="35" prefWidth="200"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Card Number *" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="cardNumberField" promptText="1234 5678 9012 3456" prefHeight="35"/>
                        </VBox>

                        <HBox spacing="10">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Expiry Date *" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="expiryField" promptText="MM/YY" prefHeight="35"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="CVV *" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="cvvField" promptText="123" prefHeight="35"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Order Summary -->
                <VBox spacing="15" prefWidth="300" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8;">
                    <Label text="Order Summary" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                    <Separator/>

                    <VBox spacing="10">
                        <HBox>
                            <Label text="Product Name x1" HBox.hgrow="ALWAYS"/>
                            <Label text=" 99.99"/>
                        </HBox>
                    </VBox>

                    <Separator/>

                    <HBox>
                        <Label text="Subtotal:" HBox.hgrow="ALWAYS"/>
                        <Label text=" 99.99"/>
                    </HBox>

                    <HBox>
                        <Label text="Shipping:" HBox.hgrow="ALWAYS"/>
                        <Label text=" 10.00"/>
                    </HBox>

                    <HBox>
                        <Label text="Tax:" HBox.hgrow="ALWAYS"/>
                        <Label text=" 8.00"/>
                    </HBox>

                    <Separator/>

                    <HBox>
                        <Label text="Total:" HBox.hgrow="ALWAYS" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <Label fx:id="orderTotalLabel" text=" 117.99"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #007bff;"/>
                    </HBox>

                    <Button text="Place Order" onAction="#handlePlaceOrder" prefHeight="45"
                            style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;
                                  -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 16px;"/>
                </VBox>
            </HBox>
        </ScrollPane>
    </center>
</BorderPane>